# {{ config.project_name }} — Environment Variables
# Copy this file to .env and fill in the values.

AWS_REGION={{ config.aws_region }}
ENVIRONMENT={{ config.default_environment }}
PROJECT_NAME={{ config.project_name }}

{% if config.include_rds %}
# Database
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database={{ config.rds.database_name }};Username={{ config.rds.username }};Password=CHANGEME
{% endif %}

{% if config.include_ecs %}
# Application
PATH_BASE={{ config.path_base_pattern }}
ASPNETCORE_URLS=http://+:{{ config.ecs.container_port }}
{% endif %}

{% if config.include_cognito %}
# Auth (AWS Cognito)
Aws__Cognito__UserPoolId=
Aws__Cognito__ClientId=
Aws__Cognito__Region={{ config.aws_region }}
{% endif %}

{% if config.include_s3_frontend %}
# S3 Frontend
S3_BUCKET_FRONTEND=
{% endif %}

{% if config.include_cloudfront %}
# CDN
VITE_CDN_URL=
{% endif %}
