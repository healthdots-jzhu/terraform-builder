provider "aws" {
  region = var.aws_region
}

# The OIDC provider resource is intentionally commented out:
# It should be created manually in the target AWS account before running
# this one-time provisioning workflow.
/*
resource "aws_iam_openid_connect_provider" "github" {
  url             = "https://token.actions.githubusercontent.com"
  client_id_list  = ["sts.amazonaws.com"]
  thumbprint_list = ["6938fd4d98bab03faadb97b34396831e3780aea1"]
}
*/

locals {
  computed_role_name    = var.role_name != "" ? var.role_name : "${var.github_repository}-github-actions-oidc-ci-role"
  computed_project_name = var.project_name != "" ? var.project_name : var.github_repository
}

# IAM role assumable by GitHub Actions via OIDC
data "aws_iam_policy_document" "assume_role_policy" {
  statement {
    effect = "Allow"
    principals {
      type        = "Federated"
      identifiers = [var.existing_oidc_provider_arn]
    }

    condition {
      test     = "StringLike"
      variable = "token.actions.githubusercontent.com:sub"
      values   = [
        "repo:${var.github_owner}/${var.github_repository}:ref:refs/heads/main",
        "repo:${var.github_owner}/${var.github_repository}:workflow_run:*",
        "repo:${var.github_owner}/${var.github_repository}:environment:*"
      ]
    }

    condition {
      test     = "StringEquals"
      variable = "token.actions.githubusercontent.com:aud"
      values   = ["sts.amazonaws.com", "https://github.com/${var.github_owner}"]
    }

    actions = ["sts:AssumeRoleWithWebIdentity"]
  }
}

resource "aws_iam_role" "github_actions_role" {
  name               = local.computed_role_name
  assume_role_policy = data.aws_iam_policy_document.assume_role_policy.json

  tags = { CreatedBy = "terraform" }
}

# IAM policy: CI permissions for ECR, S3, DynamoDB, and Terraform operations
data "aws_iam_policy_document" "ci_policy_doc" {
  statement {
    actions   = ["s3:*"]
    resources = [
      "arn:aws:s3:::${var.tf_state_bucket}",
      "arn:aws:s3:::${var.tf_state_bucket}/*",
      "arn:aws:s3:::*-alb-logs",
      "arn:aws:s3:::*-alb-logs/*"
    ]
  }

{% if config.include_secrets_manager %}
  statement {
    actions = [
      "secretsmanager:CreateSecret",
      "secretsmanager:PutSecretValue",
      "secretsmanager:DescribeSecret",
      "secretsmanager:ListSecretVersionIds"
    ]
    resources = ["arn:aws:secretsmanager:${var.aws_region}:${var.aws_account_id}:secret:*"]
  }
{% endif %}

{% if config.include_kms %}
  statement {
    actions   = ["kms:Decrypt", "kms:GenerateDataKey"]
    resources = ["arn:aws:kms:${var.aws_region}:${var.aws_account_id}:key/*"]
  }
{% endif %}

  statement {
    actions = [
      # IAM
      "iam:GetRole", "iam:ListRoles", "iam:ListRolePolicies",
      "iam:ListAttachedRolePolicies", "iam:GetPolicy", "iam:GetPolicyVersion",
      "iam:GetRolePolicy", "iam:GetInstanceProfile", "iam:ListInstanceProfiles",
      "iam:ListInstanceProfileTags", "iam:ListInstanceProfilesForRole",
      "iam:PutRolePolicy", "iam:TagInstanceProfile", "iam:TagRole",
      "iam:CreateRole", "iam:AttachRolePolicy", "iam:CreateInstanceProfile",
      "iam:AddRoleToInstanceProfile", "iam:RemoveRoleFromInstanceProfile",
      "iam:DeleteRole", "iam:DeleteRolePolicy", "iam:PassRole",
      "iam:CreateServiceLinkedRole", "iam:DeleteInstanceProfile",

{% if config.include_kms %}
      # KMS
      "kms:DescribeKey", "kms:GetKeyPolicy", "kms:GetKeyRotationStatus",
      "kms:ListAliases", "kms:ListResourceTags", "kms:ListKeys",
      "kms:ListGrants", "kms:Encrypt",
{% endif %}

{% if config.include_rds %}
      # RDS
      "rds:DescribeDBParameterGroups", "rds:DescribeDBParameters",
      "rds:ListTagsForResource", "rds:DescribeDBInstances",
      "rds:DescribeDBSubnetGroups", "rds:DescribeDBSnapshots",
      "rds:CreateDBParameterGroup", "rds:ModifyDBParameterGroup",
      "rds:ModifyDBInstance", "rds:CreateDBSubnetGroup", "rds:AddTagsToResource",
      "rds:DeleteDBParameterGroup",
{% endif %}

{% if config.include_secrets_manager %}
      # Secrets Manager
      "secretsmanager:ListSecrets", "secretsmanager:CreateSecret",
      "secretsmanager:PutSecretValue", "secretsmanager:DescribeSecret",
      "secretsmanager:ListSecretVersionIds", "secretsmanager:TagResource",
      "secretsmanager:GetResourcePolicy",
{% endif %}

{% if config.include_scheduler %}
      # EventBridge
      "events:DescribeRule", "events:ListRules", "events:ListTagsForResource",
      "events:ListTargetsByRule", "events:PutRule", "events:TagResource",
      "events:UntagResource", "events:PutTargets",
{% endif %}

      # CloudWatch / S3 / STS
      "cloudwatch:PutMetricAlarm", "cloudwatch:DeleteAlarms", "cloudwatch:DescribeAlarms",
      "s3:GetBucketLocation",
      "sts:GetCallerIdentity"
    ]
    resources = ["*"]
  }

  statement {
    actions   = ["iam:PassRole"]
    resources = ["arn:aws:iam::${var.aws_account_id}:role/${local.computed_project_name}*"]
  }

  statement {
    actions = [
      "sts:GetCallerIdentity", "sts:AssumeRole",
      "sts:AssumeRoleWithWebIdentity", "sts:AssumeRoleWithSAML"
    ]
    resources = ["*"]
  }
}

resource "aws_iam_policy" "ci_policy" {
  name   = "${local.computed_role_name}-policy"
  policy = data.aws_iam_policy_document.ci_policy_doc.json
}

# Extra policy for service wildcards
data "aws_iam_policy_document" "ci_policy_doc_extra" {
  statement {
    actions = [
      "ec2:*",
{% if config.include_ecs %}
      "ecs:*",
      "elasticloadbalancing:*",
      "application-autoscaling:*",
{% endif %}
      "logs:*",
{% if config.include_ecr %}
      "ecr:*",
{% endif %}
{% if config.include_dynamodb_cache %}
      "dynamodb:*",
{% endif %}
{% if config.include_ssm %}
      "ssm:*",
{% endif %}
{% if config.include_route53 %}
      "route53:*",
{% endif %}
{% if config.include_scheduler %}
      "lambda:*",
{% endif %}
    ]
    resources = ["*"]
  }
}

resource "aws_iam_policy" "ci_policy_extra" {
  name   = "${local.computed_role_name}-policy-extra"
  policy = data.aws_iam_policy_document.ci_policy_doc_extra.json
}

resource "aws_iam_role_policy_attachment" "attach_ci_policy_extra" {
  role       = aws_iam_role.github_actions_role.name
  policy_arn = aws_iam_policy.ci_policy_extra.arn
}

resource "aws_iam_role_policy_attachment" "attach_ci_policy" {
  role       = aws_iam_role.github_actions_role.name
  policy_arn = aws_iam_policy.ci_policy.arn
}

output "role_arn" {
  value = aws_iam_role.github_actions_role.arn
}
