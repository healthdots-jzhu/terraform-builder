{% if config.include_ecs %}
# ═══════════════════════════════════════════════════════════════════════
# ECS Fargate — {{ config.project_name }}
# ═══════════════════════════════════════════════════════════════════════

# --- ECS Variables ---
variable "ecs_task_cpu" {
  type    = string
  default = "{{ config.ecs.task_cpu }}"
}

variable "ecs_task_memory" {
  type    = string
  default = "{{ config.ecs.task_memory }}"
}

variable "ecs_service_desired_count" {
  type    = number
  default = {{ config.ecs.desired_count }}
}

{% if config.include_alb %}
variable "acm_certificate_arns" {
  description = "List of ACM certificate ARNs for HTTPS listener"
  type        = list(string)
  default     = []
}

variable "api_certificate_arn_index" {
  description = "Index into acm_certificate_arns for the default certificate"
  type        = number
  default     = 0
}
{% endif %}

{% if config.include_s3_frontend %}
variable "s3_bucket_frontend" {
  description = "S3 bucket name for frontend assets"
  type        = string
  default     = ""
}
{% endif %}

# --- ECS Cluster ---
resource "aws_ecs_cluster" "main" {
  name = "${local.name_prefix}-cluster"

  setting {
    name  = "containerInsights"
    value = "enabled"
  }

  tags = { Name = "${local.name_prefix}-ecs-cluster" }
}

# --- CloudWatch Log Group ---
resource "aws_cloudwatch_log_group" "ecs" {
  name              = "/ecs/${local.name_prefix}"
  retention_in_days = 30

  tags = { Name = "${local.name_prefix}-ecs-logs" }
}

# --- IAM: Task Execution Role ---
resource "aws_iam_role" "ecs_task_execution" {
  name_prefix = "${var.environment}-${var.project_name}-ecs-exec-"
  assume_role_policy = jsonencode({
    Version   = "2012-10-17"
    Statement = [{ Effect = "Allow", Principal = { Service = "ecs-tasks.amazonaws.com" }, Action = "sts:AssumeRole" }]
  })

  lifecycle { prevent_destroy = true }
}

resource "aws_iam_role_policy_attachment" "ecs_task_execution" {
  role       = aws_iam_role.ecs_task_execution.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
}

{% if config.include_secrets_manager %}
resource "aws_iam_role_policy" "ecs_secrets_access" {
  name = "secrets-access"
  role = aws_iam_role.ecs_task_execution.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Action = [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ]
      Resource = [
        "arn:aws:secretsmanager:${var.aws_region}:${data.aws_caller_identity.current.account_id}:secret:${var.project_name}-*"
      ]
    }]
  })
}
{% endif %}

# --- IAM: Task Role ---
resource "aws_iam_role" "ecs_task" {
  name_prefix = "${var.environment}-${var.project_name}-ecs-task-"
  assume_role_policy = jsonencode({
    Version   = "2012-10-17"
    Statement = [{ Effect = "Allow", Principal = { Service = "ecs-tasks.amazonaws.com" }, Action = "sts:AssumeRole" }]
  })

  lifecycle { prevent_destroy = true }
}

resource "aws_iam_role_policy" "ecs_task_permissions" {
  name = "task-permissions"
  role = aws_iam_role.ecs_task.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
{% if config.include_s3_frontend %}
      {
        Effect   = "Allow"
        Action   = ["s3:GetObject", "s3:PutObject", "s3:ListBucket"]
        Resource = [
          "arn:aws:s3:::${var.s3_bucket_frontend}",
          "arn:aws:s3:::${var.s3_bucket_frontend}/*"
        ]
      },
{% endif %}
{% if config.include_ssm %}
      {
        Effect   = "Allow"
        Action   = ["ssm:GetParameter", "ssm:GetParameters"]
        Resource = "arn:aws:ssm:${var.aws_region}:${data.aws_caller_identity.current.account_id}:parameter/${var.environment}/${var.project_name}/*"
      },
{% endif %}
{% if config.include_kms %}
      {
        Effect   = "Allow"
        Action   = ["kms:Decrypt", "kms:GenerateDataKey"]
        Resource = aws_kms_key.main.arn
      },
{% endif %}
{% if config.include_dynamodb_cache %}
      {
        Effect   = "Allow"
        Action   = [
          "dynamodb:GetItem",
          "dynamodb:PutItem",
          "dynamodb:DeleteItem",
          "dynamodb:Query",
          "dynamodb:UpdateItem"
        ]
        Resource = aws_dynamodb_table.cache.arn
      },
{% endif %}
    ]
  })
}

# --- Security Groups ---
{% if config.include_alb %}
resource "aws_security_group" "alb" {
  name_prefix = "${local.name_prefix}-alb-"
  vpc_id      = aws_vpc.main.id
  description = "Application Load Balancer"

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
    description = "HTTP"
  }

  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
    description = "HTTPS"
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "${local.name_prefix}-alb-sg" }
}
{% endif %}

resource "aws_security_group" "ecs_tasks" {
  name_prefix = "${local.name_prefix}-ecs-tasks-"
  vpc_id      = aws_vpc.main.id
  description = "ECS tasks"

{% if config.include_alb %}
  ingress {
    from_port       = {{ config.ecs.container_port }}
    to_port         = {{ config.ecs.container_port }}
    protocol        = "tcp"
    security_groups = [aws_security_group.alb.id]
    description     = "From ALB"
  }
{% endif %}

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "${local.name_prefix}-ecs-tasks-sg" }
}

# --- Task Definition ---
locals {
  container_image = "${aws_ecr_repository.app.repository_url}:latest"

  container_secrets = [
{% if config.include_secrets_manager %}
    {
      name      = "ConnectionStrings__Postgres"
      valueFrom = data.aws_secretsmanager_secret.postgres.arn
    },
    {
      name      = "GitHubModels__ApiToken"
      valueFrom = data.aws_secretsmanager_secret.github_token.arn
    },
{% endif %}
  ]
}

{% if config.include_secrets_manager %}
data "aws_secretsmanager_secret" "postgres" {
  name = "${var.project_name}-${var.environment}-postgres-connection"
}

data "aws_secretsmanager_secret" "github_token" {
  name = "${var.project_name}-${var.environment}-github-models-token"
}
{% endif %}

resource "aws_ecs_task_definition" "app" {
  family                   = "${local.name_prefix}-app"
  network_mode             = "awsvpc"
  requires_compatibilities = ["FARGATE"]
  cpu                      = var.ecs_task_cpu
  memory                   = var.ecs_task_memory
  execution_role_arn       = aws_iam_role.ecs_task_execution.arn
  task_role_arn            = aws_iam_role.ecs_task.arn

  container_definitions = jsonencode([{
    name      = "${local.name_prefix}-app"
    image     = local.container_image
    essential = true
    portMappings = [{
      containerPort = {{ config.ecs.container_port }}
      protocol      = "tcp"
    }]
    environment = [
      { name = "ASPNETCORE_ENVIRONMENT", value = var.environment },
      { name = "PATH_BASE", value = var.path_base },
      { name = "Aws__Region", value = var.aws_region },
{% if config.include_ssm %}
      { name = "Hashids__ParameterName", value = "/${var.environment}/${var.project_name}/hashids/salt" },
{% endif %}
{% if config.include_dynamodb_cache %}
      { name = "DynamoCache__TableName", value = aws_dynamodb_table.cache.name },
{% endif %}
    ]
{% if config.include_secrets_manager %}
    secrets = local.container_secrets
{% endif %}
    logConfiguration = {
      logDriver = "awslogs"
      options = {
        "awslogs-group"         = aws_cloudwatch_log_group.ecs.name
        "awslogs-region"        = var.aws_region
        "awslogs-stream-prefix" = "ecs"
      }
    }
  }])
}

# --- ECS Service ---
resource "aws_ecs_service" "app" {
  name            = "${local.name_prefix}-app"
  cluster         = aws_ecs_cluster.main.id
  task_definition = aws_ecs_task_definition.app.arn
  desired_count   = var.ecs_service_desired_count
  launch_type     = "FARGATE"

  network_configuration {
    subnets          = [aws_subnet.public.id, aws_subnet.public_2b.id]
    security_groups  = [aws_security_group.ecs_tasks.id]
    assign_public_ip = true
  }

{% if config.include_alb %}
  load_balancer {
    target_group_arn = aws_lb_target_group.app.arn
    container_name   = "${local.name_prefix}-app"
    container_port   = {{ config.ecs.container_port }}
  }
{% endif %}

  lifecycle {
    ignore_changes = [desired_count, task_definition]
  }
}

# --- Auto Scaling ---
resource "aws_appautoscaling_target" "ecs" {
  max_capacity       = 3
  min_capacity       = 1
  resource_id        = "service/${aws_ecs_cluster.main.name}/${aws_ecs_service.app.name}"
  scalable_dimension = "ecs:service:DesiredCount"
  service_namespace  = "ecs"
}

resource "aws_appautoscaling_policy" "ecs_cpu" {
  name               = "${local.name_prefix}-cpu-tracking"
  policy_type        = "TargetTrackingScaling"
  resource_id        = aws_appautoscaling_target.ecs.resource_id
  scalable_dimension = aws_appautoscaling_target.ecs.scalable_dimension
  service_namespace  = aws_appautoscaling_target.ecs.service_namespace

  target_tracking_scaling_policy_configuration {
    predefined_metric_specification {
      predefined_metric_type = "ECSServiceAverageCPUUtilization"
    }
    target_value = 85.0
  }
}

{% if config.include_alb %}
# ═══════════════════════════════════════════════════════════════════════
# Application Load Balancer
# ═══════════════════════════════════════════════════════════════════════

# ALB Logs S3 Bucket
resource "aws_s3_bucket" "alb_logs" {
  bucket = "${var.project_name}-${var.environment}-alb-logs"

  tags = { Name = "${local.name_prefix}-alb-logs" }
}

resource "aws_s3_bucket_versioning" "alb_logs" {
  bucket = aws_s3_bucket.alb_logs.id
  versioning_configuration { status = "Enabled" }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "alb_logs" {
  bucket = aws_s3_bucket.alb_logs.id
  rule {
    apply_server_side_encryption_by_default { sse_algorithm = "AES256" }
  }
}

resource "aws_s3_bucket_public_access_block" "alb_logs" {
  bucket                  = aws_s3_bucket.alb_logs.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_lifecycle_configuration" "alb_logs" {
  bucket = aws_s3_bucket.alb_logs.id
  rule {
    id     = "transition-and-expire"
    status = "Enabled"
    transition {
      days          = 30
      storage_class = "STANDARD_IA"
    }
    expiration { days = 365 }
  }
}

resource "aws_lb" "main" {
  name_prefix        = "pf-"
  internal           = false
  load_balancer_type = "application"
  security_groups    = [aws_security_group.alb.id]
  subnets            = [aws_subnet.public.id, aws_subnet.public_2b.id]

  access_logs {
    bucket  = aws_s3_bucket.alb_logs.id
    prefix  = "alb"
    enabled = true
  }

  tags = { Name = "${local.name_prefix}-alb" }
}

resource "aws_lb_target_group" "app" {
  name_prefix = "pf-"
  port        = {{ config.ecs.container_port }}
  protocol    = "HTTP"
  vpc_id      = aws_vpc.main.id
  target_type = "ip"

  health_check {
    path                = "{{ config.ecs.health_check_path }}"
    interval            = 300
    timeout             = 60
    healthy_threshold   = 2
    unhealthy_threshold = 3
    matcher             = "200"
  }

  tags = { Name = "${local.name_prefix}-tg" }
}

# HTTP → HTTPS redirect
resource "aws_lb_listener" "http" {
  load_balancer_arn = aws_lb.main.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type = "redirect"
    redirect {
      port        = "443"
      protocol    = "HTTPS"
      status_code = "HTTP_301"
    }
  }
}

# HTTPS listener (conditional on certificates being provided)
resource "aws_lb_listener" "https" {
  count             = length(var.acm_certificate_arns) > 0 ? 1 : 0
  load_balancer_arn = aws_lb.main.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-2021-06"
  certificate_arn   = var.acm_certificate_arns[var.api_certificate_arn_index]

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.app.arn
  }
}

{% if config.include_route53 %}
# Listener rule for path-based routing
resource "aws_lb_listener_rule" "api_path" {
  count        = length(var.acm_certificate_arns) > 0 ? 1 : 0
  listener_arn = aws_lb_listener.https[0].arn
  priority     = 100

  action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.app.arn
  }

  condition {
    path_pattern { values = ["${var.path_base}/*"] }
  }

  condition {
    host_header { values = ["${var.api_subdomain}.${var.route53_zone_name}"] }
  }
}
{% endif %}
{% endif %}

{% if config.include_route53 %}
# ═══════════════════════════════════════════════════════════════════════
# Route53 DNS Record
# ═══════════════════════════════════════════════════════════════════════
data "aws_route53_zone" "main" {
  name         = var.route53_zone_name
  private_zone = false
}

resource "aws_route53_record" "api" {
  zone_id = data.aws_route53_zone.main.zone_id
  name    = var.api_subdomain
  type    = "A"

  alias {
    name                   = aws_lb.main.dns_name
    zone_id                = aws_lb.main.zone_id
    evaluate_target_health = false
  }
}
{% endif %}

{% if config.include_dynamodb_cache %}
# ═══════════════════════════════════════════════════════════════════════
# DynamoDB Cache Table
# ═══════════════════════════════════════════════════════════════════════
resource "aws_dynamodb_table" "cache" {
  name         = "${var.project_name}-${var.environment}-cache"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "CacheKey"

  attribute {
    name = "CacheKey"
    type = "S"
  }

  ttl {
    attribute_name = "ExpiresAt"
    enabled        = true
  }

  tags = { Name = "${local.name_prefix}-dynamodb-cache" }
}
{% endif %}

# --- ECS Outputs ---
output "ecs_cluster_name" {
  value = aws_ecs_cluster.main.name
}

output "ecs_service_name" {
  value = aws_ecs_service.app.name
}

{% if config.include_alb %}
output "alb_dns_name" {
  value = aws_lb.main.dns_name
}
{% endif %}

{% if config.include_secrets_manager %}
output "postgres_connection_secret_arn" {
  value = data.aws_secretsmanager_secret.postgres.arn
}
{% endif %}
{% endif %}
