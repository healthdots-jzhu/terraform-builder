name: "Onetime Provision: AWS CI Role + GitHub Secrets & Variables"

permissions:
  contents: read
  id-token: write

on:
  workflow_dispatch:
    inputs:
      aws_account_id:
        description: 'AWS account id (if omitted, inferred from credentials)'
        required: false
      github_owner:
        description: 'GitHub org/user (if omitted, uses repo owner)'
        required: false
      repository:
        description: 'Repository name (if omitted, uses this repo)'
        required: false
      role_arn:
        description: 'Optional ARN of an existing IAM role to assume via OIDC'
        required: false
      aws_region:
        description: 'AWS region (overrides secret AWS_REGION)'
        required: false
      provision_github_token_note:
        description: 'NOTE: create repo secret PROVISION_GITHUB_TOKEN before running.'
        required: false
        default: 'N/A - note only'
      tf_state_bucket:
        description: 'TF state bucket name'
        required: false
        default: '{{ config.project_name }}-terraform-state'
      tf_state_dynamodb_table:
        description: 'TF state DynamoDB table name'
        required: false
        default: '{{ config.project_name }}-terraform-locks'

jobs:
  provision:
    name: Onetime provision (Terraform)
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: terraform/bootstrap_orchestration
    steps:
      - name: Checkout
        uses: actions/checkout@v6.0.2

      - name: Set GitHub defaults (owner/repo) when inputs omitted
        env:
          INPUT_GITHUB_OWNER: {% raw %}${{ github.event.inputs.github_owner }}{% endraw %}
          INPUT_REPOSITORY: {% raw %}${{ github.event.inputs.repository }}{% endraw %}
        run: |
          REPO_NAME=${GITHUB_REPOSITORY##*/}
          REPO_OWNER=${GITHUB_REPOSITORY%%/*}
          if [ -n "$INPUT_GITHUB_OWNER" ]; then
            echo "TF_VAR_github_owner=$INPUT_GITHUB_OWNER" >> $GITHUB_ENV
          else
            echo "TF_VAR_github_owner=$REPO_OWNER" >> $GITHUB_ENV
          fi
          if [ -n "$INPUT_REPOSITORY" ]; then
            echo "TF_VAR_repository=$INPUT_REPOSITORY" >> $GITHUB_ENV
          else
            echo "TF_VAR_repository=$REPO_NAME" >> $GITHUB_ENV
          fi
          if [ -n "${INPUT_REPOSITORY}" ]; then
            ROLE_REPO="${INPUT_REPOSITORY}"
          else
            ROLE_REPO="$REPO_NAME"
          fi
          echo "TF_VAR_role_name=${ROLE_REPO}-github-actions-oidc-role" >> $GITHUB_ENV

      - name: Set TF_VAR_aws_account_id from input when provided
        if: {% raw %}${{ github.event.inputs.aws_account_id != '' }}{% endraw %}
        run: |
          echo "TF_VAR_aws_account_id={% raw %}${{ github.event.inputs.aws_account_id }}{% endraw %}" >> $GITHUB_ENV

      - name: Configure AWS credentials (OIDC role assumption)
        if: {% raw %}${{ github.event.inputs.role_arn != '' }}{% endraw %}
        uses: aws-actions/configure-aws-credentials@v5.1.1
        with:
          role-to-assume: {% raw %}${{ github.event.inputs.role_arn }}{% endraw %}
          aws-region: {% raw %}${{ github.event.inputs.aws_region || secrets.AWS_REGION || '{% endraw %}{{ config.aws_region }}{% raw %}' }}{% endraw %}
          audience: sts.amazonaws.com

      - name: Configure AWS credentials (access keys fallback)
        if: {% raw %}${{ github.event.inputs.role_arn == '' }}{% endraw %}
        uses: aws-actions/configure-aws-credentials@v5.1.1
        with:
          aws-access-key-id: {% raw %}${{ secrets.AWS_ACCESS_KEY_ID }}{% endraw %}
          aws-secret-access-key: {% raw %}${{ secrets.AWS_SECRET_ACCESS_KEY }}{% endraw %}
          aws-region: {% raw %}${{ github.event.inputs.aws_region || secrets.AWS_REGION || '{% endraw %}{{ config.aws_region }}{% raw %}' }}{% endraw %}

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v2
        with:
          terraform_version: '1.5.7'

      - name: Detect existing OIDC provider ARN
        run: |
          set -euo pipefail
          PROVIDERS=$(aws iam list-open-id-connect-providers --query 'OpenIDConnectProviderList[].Arn' --output text || true)
          OIDC_ARN=""
          for arn in $PROVIDERS; do
            URL=$(aws iam get-open-id-connect-provider --open-id-connect-provider-arn "$arn" --query 'Url' --output text 2>/dev/null || true)
            if [ -n "$URL" ] && echo "$URL" | grep -qi "token.actions.githubusercontent.com"; then
              OIDC_ARN=$arn
              break
            fi
          done
          if [ -z "$OIDC_ARN" ]; then
            echo "ERROR: No OIDC provider for token.actions.githubusercontent.com found." >&2
            exit 1
          fi
          echo "Found OIDC provider ARN: $OIDC_ARN"
          echo "TF_VAR_existing_oidc_provider_arn=$OIDC_ARN" >> $GITHUB_ENV

      - name: Provide GitHub token to Terraform
        env:
          PROVISION_GITHUB_TOKEN: {% raw %}${{ secrets.PROVISION_GITHUB_TOKEN }}{% endraw %}
          GITHUB_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: |
          if [ -n "$PROVISION_GITHUB_TOKEN" ]; then
            echo "TF_VAR_github_token=$PROVISION_GITHUB_TOKEN" >> $GITHUB_ENV
          else
            echo "TF_VAR_github_token=$GITHUB_TOKEN" >> $GITHUB_ENV
          fi

      - name: Detect AWS account id (if not provided)
        if: {% raw %}${{ github.event.inputs.aws_account_id == '' }}{% endraw %}
        run: |
          AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
          echo "TF_VAR_aws_account_id=$AWS_ACCOUNT_ID" >> $GITHUB_ENV

      - name: Export TF state bucket/table from inputs
        run: |
          if [ -n "{% raw %}${{ github.event.inputs.tf_state_bucket }}{% endraw %}" ]; then
            echo "TF_VAR_tf_state_bucket={% raw %}${{ github.event.inputs.tf_state_bucket }}{% endraw %}" >> $GITHUB_ENV
          fi
          if [ -n "{% raw %}${{ github.event.inputs.tf_state_dynamodb_table }}{% endraw %}" ]; then
            echo "TF_VAR_tf_state_dynamodb_table={% raw %}${{ github.event.inputs.tf_state_dynamodb_table }}{% endraw %}" >> $GITHUB_ENV
          fi

      - name: Init Terraform
        run: |
          terraform init -reconfigure \
            -backend-config="bucket={% raw %}${{ github.event.inputs.tf_state_bucket || '{% endraw %}{{ config.project_name }}-terraform-state{% raw %}' }}{% endraw %}" \
            -backend-config="key={{ config.project_name }}/bootstrap.tfstate" \
            -backend-config="region={% raw %}${{ github.event.inputs.aws_region || secrets.AWS_REGION || '{% endraw %}{{ config.aws_region }}{% raw %}' }}{% endraw %}" \
            -backend-config="dynamodb_table={% raw %}${{ github.event.inputs.tf_state_dynamodb_table || '{% endraw %}{{ config.project_name }}-terraform-locks{% raw %}' }}{% endraw %}" \
            -backend-config="encrypt=true"

      - name: Apply bootstrap Terraform
        run: |
          terraform plan -var-file="bootstrap_environments.tfvars" -out=bootstrap-plan
          terraform apply -auto-approve bootstrap-plan

      - name: Show outputs
        run: terraform output || true
